#!/sbin/openrc-run

PIDFILE=/var/run/leilfs-cgiserver.pid

depend() {
	need net
}

start() {
	ebegin "Starting leilfs CGI server"
	start-stop-daemon --start --quiet --exec /usr/bin/leil-cgiserver \
	--pidfile "${PIDFILE}" --make-pidfile --background \
	-- -H ${BIND_HOST} -P ${BIND_PORT}
	eend $?
}

stop() {
	ebegin "Stopping leilfs CGI server"
	start-stop-daemon --stop -q --pidfile "${PIDFILE}"
	eend $?
}
