name="${name:-versitygw}"
command="/usr/bin/versitygw"
command_args="${versitygw_opts}"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
start_stop_daemon_args="${SSD_OPTS}"

depend() {
	need net
}
